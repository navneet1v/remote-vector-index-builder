From d72838bc328dc61f0222e95d29aa54c2ccdcf4aa Mon Sep 17 00:00:00 2001
From: Navneet Verma <navneev@amazon.com>
Date: Thu, 29 Oct 2026 22:46:15 +0000
Subject: [PATCH] GpuIndexCagra::copyTo: optional projection of HNSW layer-1
 links into the CAGRA base layer

On datasets made of well-separated clusters, the k-NN graph that CAGRA
prunes its graph from is itself split into disconnected components, so
the CAGRA graph is too. After conversion to IndexHNSWCagra with
base_level_only=true, searches start from random base-level entry
points and can only reach the components those points land in: recall
drops (e.g. recall@600 ~0.15 vs ~0.99 for a CPU-built HNSW on a 300k x
1024 product-catalogue corpus) and identical queries return different
results.

This adds an optional step to GpuIndexCagra::copyTo, enabled through a
new overload

    copyTo(IndexHNSWCagra* index, bool skip_storage,
           const CagraUpperLevelProjectionParams* projection,
           CagraUpperLevelProjectionStats* stats = nullptr)

(the existing copyTo is unchanged and passes nullptr). It requires
base_level_only=true and leaves the output base-level only, so the file
format is unchanged:

1. Promote nodes to layer 1 with faiss's HNSW level generator
   (HNSW::random_level, seed 12345, id order) as for an HNSW with 2 * M
   links per node: probability 1 / (2 * M), where M is the HNSW m of the
   index and must be passed by the caller (CagraUpperLevelProjectionParams::M).
2. Copy only the promoted rows of the CAGRA dataset as float (fp32 /
   fp16 / int8; works with skip_storage). The dataset must be the
   caller's host array, i.e. store_dataset = false (the configuration the
   OpenSearch remote-vector-index-builder uses); the projection throws
   with store_dataset = true.
3. Build layer 1 as a temporary single-level IndexHNSWFlat over the
   promoted vectors (2 * M links per node; no levels above it), with
   faiss's own HNSW insertion. Both copies of the promoted vectors are
   freed as soon as it is built; only its graph is kept.
4. Project every layer-1 link a-b into level 0 as a->b and b->a: into an
   empty slot if there is one, else by overwriting the row's tail
   (CAGRA's lowest-ranked links), at most max_share (default 0.5) of a
   full row; rows that are not full are uncapped. With
   protect_last_in_edge (default true) a link that is a node's last
   level-0 in-edge is never overwritten, so no node becomes
   unreachable. Rows are processed in parallel (OpenMP), one thread per
   row; in-degrees are shared atomics.

Measured on an NVIDIA L4 with cuVS 26.08.01 (CAGRA built with the
remote-vector-index-builder defaults: IVF_PQ, graph/intermediate degree
64/64, n_probes 5), base-level-only search at ef_search 600:
  - 300k x 1024 clustered catalogue (m = 16): level-0 SCCs 218 -> 1;
    recall@600 0.11-0.17 -> 0.95-0.99; build time +0.45 s (7.4 -> 7.85 s).
  - SIFT-1M / Cohere-1M (already connected): recall within +-0.002.

Signed-off-by: Navneet Verma <navneev@amazon.com>
---
 faiss/gpu/GpuIndexCagra.cu | 425 +++++++++++++++++++++++++++++++++++++
 faiss/gpu/GpuIndexCagra.h  |  50 +++++
 2 files changed, 475 insertions(+)

diff --git a/faiss/gpu/GpuIndexCagra.cu b/faiss/gpu/GpuIndexCagra.cu
index 2a2f61e..aa5b341 100644
--- a/faiss/gpu/GpuIndexCagra.cu
+++ b/faiss/gpu/GpuIndexCagra.cu
@@ -24,6 +24,12 @@
 #include <faiss/IndexHNSW.h>
 #include <faiss/gpu/GpuIndexCagra.h>
 #include <faiss/gpu/StandardGpuResources.h>
+#include <faiss/impl/HNSW.h>
+#include <faiss/utils/utils.h>
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <memory>
 #include <cstddef>
 #include <cstdio>
 #include <faiss/gpu/impl/CuvsCagra.cuh>
@@ -33,6 +39,357 @@
 namespace faiss {
 namespace gpu {
 
+namespace {
+
+inline float to_float(float v) {
+    return v;
+}
+inline float to_float(half v) {
+    return __half2float(v);
+}
+inline float to_float(int8_t v) {
+    return static_cast<float>(v);
+}
+
+/// Copies rows `ids` of a host [n, d] dataset into a host float array
+/// [ids.size(), d]. The dataset must be in host memory: with
+/// store_dataset = false (the only configuration the OpenSearch
+/// remote-vector-index-builder uses) CuvsCagra keeps a pointer to the caller's
+/// host array, which is still alive while copyTo runs.
+template <typename T>
+std::vector<float> gather_rows_as_float(
+        const T* data,
+        int d,
+        const std::vector<idx_t>& ids) {
+    FAISS_THROW_IF_NOT_MSG(
+            getDeviceForAddress(data) < 0,
+            "GpuIndexCagra::copyTo: upper-level projection needs the dataset "
+            "in host memory");
+    std::vector<float> out(ids.size() * d);
+    for (size_t i = 0; i < ids.size(); i++) {
+        const T* row = data + ids[i] * d;
+        for (int j = 0; j < d; j++) {
+            out[i * d + j] = to_float(row[j]);
+        }
+    }
+    return out;
+}
+
+/// Draws every node's level with faiss's HNSW level generator (seed 12345, in
+/// id order, as HNSW::prepare_level_tab does) for an HNSW with M links per
+/// upper-level node, i.e. promotion probability 1 / M, and returns the nodes
+/// at level >= 1.
+std::vector<idx_t> draw_promoted(idx_t n, int M) {
+    HNSW draw(M);
+    draw.assign_probas.clear();
+    draw.cum_nneighbor_per_level.clear();
+    draw.set_default_probas(M, 1.0f / std::log(M));
+    std::vector<idx_t> promoted;
+    for (idx_t i = 0; i < n; i++) {
+        if (draw.random_level() >= 1) {
+            promoted.push_back(i);
+        }
+    }
+    return promoted;
+}
+
+/// Builds layer 1: a temporary single-level IndexHNSWFlat over the promoted
+/// vectors `xp` (every node preset to level 0 with M slots, so no levels above
+/// it are created), using faiss's own HNSW insertion. Only the graph is kept:
+/// `xp` and the index's flat storage are freed before returning.
+std::unique_ptr<IndexHNSWFlat> build_layer1(
+        std::vector<float>& xp,
+        int d,
+        faiss::MetricType metric,
+        int M,
+        int ef_construction) {
+    const idx_t np = xp.size() / d;
+    auto up = std::make_unique<IndexHNSWFlat>(d, M, metric);
+    up->hnsw.assign_probas.clear();
+    up->hnsw.cum_nneighbor_per_level.clear();
+    up->hnsw.cum_nneighbor_per_level.push_back(0);
+    up->hnsw.cum_nneighbor_per_level.push_back(M);
+    up->hnsw.levels.assign(np, 1); // stored level = max level + 1
+    up->hnsw.efConstruction = ef_construction;
+    up->add(np, xp.data()); // levels are preset, so IndexHNSW::add uses them
+    std::vector<float>().swap(xp);
+    delete up->storage;
+    up->storage = nullptr;
+    up->own_fields = false;
+    return up;
+}
+
+/// Directed links to add to level 0, grouped by source row (CSR layout): the
+/// targets of row a are links[row_start[a] .. row_start[a + 1]).
+struct RowLinks {
+    std::vector<size_t> row_start;
+    std::vector<HNSW::storage_idx_t> links;
+};
+
+/// Turns every layer-1 link a-b into a->b and b->a (global ids), grouped by
+/// source row with a stable counting sort, so each row keeps the order a
+/// sequential pass over the promoted nodes would use.
+RowLinks group_links_by_row(
+        const HNSW& layer1,
+        const std::vector<idx_t>& promoted,
+        idx_t n) {
+    std::vector<HNSW::storage_idx_t> src, dst;
+    for (size_t i = 0; i < promoted.size(); i++) {
+        size_t b, e;
+        layer1.neighbor_range(i, 0, &b, &e);
+        for (size_t j = b; j < e; j++) {
+            HNSW::storage_idx_t s = layer1.neighbors[j];
+            if (s < 0 || promoted[s] == promoted[i]) {
+                continue;
+            }
+            src.push_back(promoted[i]);
+            dst.push_back(promoted[s]);
+            src.push_back(promoted[s]);
+            dst.push_back(promoted[i]);
+        }
+    }
+    RowLinks out;
+    out.row_start.assign(n + 1, 0);
+    for (auto a : src) {
+        out.row_start[a + 1]++;
+    }
+    for (idx_t i = 0; i < n; i++) {
+        out.row_start[i + 1] += out.row_start[i];
+    }
+    out.links.resize(src.size());
+    std::vector<size_t> cursor(out.row_start.begin(), out.row_start.end() - 1);
+    for (size_t k = 0; k < src.size(); k++) {
+        out.links[cursor[src[k]]++] = dst[k];
+    }
+    return out;
+}
+
+using InDegrees = std::unique_ptr<std::atomic<int32_t>[]>;
+
+/// Level-0 in-degree of every node (atomics, shared between rows).
+InDegrees count_in_degrees(const HNSW& h, idx_t n) {
+    InDegrees indeg(new std::atomic<int32_t>[n]);
+    for (idx_t i = 0; i < n; i++) {
+        indeg[i].store(0, std::memory_order_relaxed);
+    }
+#pragma omp parallel for
+    for (idx_t i = 0; i < n; i++) {
+        size_t b, e;
+        h.neighbor_range(i, 0, &b, &e);
+        for (size_t j = b; j < e; j++) {
+            if (h.neighbors[j] >= 0) {
+                indeg[h.neighbors[j]].fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+    }
+    return indeg;
+}
+
+idx_t count_zero_in_degree(const InDegrees& indeg, idx_t n) {
+    idx_t zero = 0;
+#pragma omp parallel for reduction(+ : zero)
+    for (idx_t i = 0; i < n; i++) {
+        zero += indeg[i].load(std::memory_order_relaxed) == 0;
+    }
+    return zero;
+}
+
+/// Removes one in-edge of a node; with protect_last_in_edge, refuses to remove
+/// the last one (compare-and-swap, so concurrent rows cannot orphan it).
+inline bool release_in_edge(std::atomic<int32_t>& indeg, bool protect) {
+    if (!protect) {
+        indeg.fetch_sub(1, std::memory_order_relaxed);
+        return true;
+    }
+    int32_t cur = indeg.load(std::memory_order_relaxed);
+    while (cur > 1) {
+        if (indeg.compare_exchange_weak(
+                    cur, cur - 1, std::memory_order_relaxed)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/// Per-thread projection counters, merged with an OpenMP reduction.
+struct ProjectionCounters {
+    size_t added_into_empty = 0;
+    size_t added_by_overwrite = 0;
+    size_t already_present = 0;
+    size_t skipped_cap = 0;
+    size_t protected_slots_skipped = 0;
+    size_t skipped_no_free_slot = 0;
+    size_t rows_not_full = 0;
+
+    ProjectionCounters& operator+=(const ProjectionCounters& o) {
+        added_into_empty += o.added_into_empty;
+        added_by_overwrite += o.added_by_overwrite;
+        already_present += o.already_present;
+        skipped_cap += o.skipped_cap;
+        protected_slots_skipped += o.protected_slots_skipped;
+        skipped_no_free_slot += o.skipped_no_free_slot;
+        rows_not_full += o.rows_not_full;
+        return *this;
+    }
+};
+
+#pragma omp declare reduction(                                   \
+                merge_counters : ProjectionCounters : omp_out += \
+                omp_in)
+
+/// Adds links[begin, end) to one level-0 row: skips links already present,
+/// fills empty slots first, then overwrites the row's tail (CAGRA's
+/// lowest-ranked links) up to `cap` times (no cap for rows that are not full
+/// to begin with), never removing a node's last in-edge when `protect`.
+inline void add_links_to_row(
+        HNSW::storage_idx_t* row,
+        int nb0,
+        int cap,
+        const HNSW::storage_idx_t* begin,
+        const HNSW::storage_idx_t* end,
+        std::atomic<int32_t>* indeg,
+        bool protect,
+        ProjectionCounters& c) {
+    int row_cap = cap;
+    for (int j = 0; j < nb0; j++) {
+        if (row[j] < 0) {
+            row_cap = nb0;
+            c.rows_not_full++;
+            break;
+        }
+    }
+    int replaced = 0;
+    int tail = nb0 - 1; // next tail slot to try overwriting
+    for (const HNSW::storage_idx_t* it = begin; it != end; ++it) {
+        const HNSW::storage_idx_t b = *it;
+        int empty = -1;
+        bool present = false;
+        for (int j = 0; j < nb0; j++) {
+            if (row[j] == b) {
+                present = true;
+                break;
+            }
+            if (row[j] < 0 && empty < 0) {
+                empty = j;
+            }
+        }
+        if (present) {
+            c.already_present++;
+            continue;
+        }
+        if (empty >= 0) {
+            row[empty] = b;
+            indeg[b].fetch_add(1, std::memory_order_relaxed);
+            c.added_into_empty++;
+            continue;
+        }
+        if (replaced >= row_cap) {
+            c.skipped_cap++;
+            continue;
+        }
+        // this slot may hold its target's last in-edge: then keep it
+        while (tail >= 0 && !release_in_edge(indeg[row[tail]], protect)) {
+            tail--;
+            c.protected_slots_skipped++;
+        }
+        if (tail < 0) {
+            c.skipped_no_free_slot++;
+            continue;
+        }
+        row[tail] = b;
+        indeg[b].fetch_add(1, std::memory_order_relaxed);
+        tail--;
+        replaced++;
+        c.added_by_overwrite++;
+    }
+}
+
+/// Adds all grouped links to the level-0 rows of `h`, in parallel: one thread
+/// per row, so row writes never race; in-degrees are shared atomics.
+ProjectionCounters add_links(
+        HNSW& h,
+        idx_t n,
+        const RowLinks& links,
+        InDegrees& indeg,
+        float max_share,
+        bool protect) {
+    size_t begin0, end0;
+    h.neighbor_range(0, 0, &begin0, &end0);
+    const int nb0 = static_cast<int>(end0 - begin0);
+    const int cap = static_cast<int>(max_share * nb0);
+    ProjectionCounters total;
+#pragma omp parallel for schedule(dynamic, 1024) reduction(merge_counters : total)
+    for (idx_t a = 0; a < n; a++) {
+        if (links.row_start[a] == links.row_start[a + 1]) {
+            continue;
+        }
+        size_t rb, re;
+        h.neighbor_range(a, 0, &rb, &re);
+        add_links_to_row(
+                h.neighbors.data() + rb,
+                nb0,
+                cap,
+                links.links.data() + links.row_start[a],
+                links.links.data() + links.row_start[a + 1],
+                indeg.get(),
+                protect,
+                total);
+    }
+    return total;
+}
+
+/// Builds HNSW layer 1 over the promoted vectors `xp` (released as soon as it
+/// is built) and projects its links into the level-0 lists of `index`.
+void project_upper_level(
+        faiss::IndexHNSWCagra* index,
+        const std::vector<idx_t>& promoted,
+        std::vector<float>& xp,
+        int d,
+        faiss::MetricType metric,
+        int M,
+        int ef_construction,
+        float max_share,
+        bool protect_last_in_edge,
+        CagraUpperLevelProjectionStats* stats_out) {
+    CagraUpperLevelProjectionStats stats;
+    stats.promoted = promoted.size();
+    const idx_t n = index->ntotal;
+    if (promoted.size() >= 2) {
+        double t0 = getmillisecs();
+        std::unique_ptr<IndexHNSWFlat> layer1 =
+                build_layer1(xp, d, metric, M, ef_construction);
+        stats.layer1_build_ms = getmillisecs() - t0;
+
+        t0 = getmillisecs();
+        RowLinks links = group_links_by_row(layer1->hnsw, promoted, n);
+        layer1.reset();
+        InDegrees indeg = count_in_degrees(index->hnsw, n);
+        stats.in_degree0_before = count_zero_in_degree(indeg, n);
+        ProjectionCounters c = add_links(
+                index->hnsw,
+                n,
+                links,
+                indeg,
+                max_share,
+                protect_last_in_edge);
+        stats.in_degree0_after = count_zero_in_degree(indeg, n);
+        stats.projection_ms = getmillisecs() - t0;
+
+        stats.added_into_empty = c.added_into_empty;
+        stats.added_by_overwrite = c.added_by_overwrite;
+        stats.already_present = c.already_present;
+        stats.skipped_cap = c.skipped_cap;
+        stats.protected_slots_skipped = c.protected_slots_skipped;
+        stats.skipped_no_free_slot = c.skipped_no_free_slot;
+        stats.rows_not_full = c.rows_not_full;
+    }
+    if (stats_out) {
+        *stats_out = stats;
+    }
+}
+
+} // namespace
+
 GpuIndexCagra::GpuIndexCagra(
         GpuResourcesProvider* provider,
         int dims,
@@ -409,6 +766,34 @@ void GpuIndexCagra::copyFrom(const faiss::IndexHNSWCagra* index) {
 void GpuIndexCagra::copyTo(
         faiss::IndexHNSWCagra* index,
         bool skip_storage) const {
+    copyTo(index, skip_storage, nullptr, nullptr);
+}
+
+void GpuIndexCagra::copyTo(
+        faiss::IndexHNSWCagra* index,
+        bool skip_storage,
+        const CagraUpperLevelProjectionParams* projection,
+        CagraUpperLevelProjectionStats* stats) const {
+    FAISS_THROW_IF_NOT_MSG(
+            !projection || index->base_level_only,
+            "GpuIndexCagra::copyTo: upper-level projection requires "
+            "base_level_only = true");
+    FAISS_THROW_IF_NOT_MSG(
+            !projection || projection->M > 0,
+            "GpuIndexCagra::copyTo: upper-level projection needs M > 0 (the "
+            "HNSW m of the index)");
+    FAISS_THROW_IF_NOT_MSG(
+            !projection ||
+                    (projection->max_share >= 0 && projection->max_share <= 1),
+            "GpuIndexCagra::copyTo: invalid projection parameters");
+    // The projection reads the promoted vectors from the caller's host array,
+    // which CuvsCagra only references when store_dataset = false. The OpenSearch
+    // remote-vector-index-builder never sets store_dataset = true, so that
+    // configuration is not supported.
+    FAISS_THROW_IF_NOT_MSG(
+            !projection || !cagraConfig_.store_dataset,
+            "GpuIndexCagra::copyTo: upper-level projection is not supported "
+            "with store_dataset = true");
     FAISS_ASSERT(
             !std::holds_alternative<std::monostate>(index_) &&
             this->is_trained && index);
@@ -594,6 +979,46 @@ void GpuIndexCagra::copyTo(
         }
     }
 
+    if (projection) {
+        // layer 1 as in an HNSW with 2 * m links per node: promotion 1 / (2 * m)
+        const int pM = 2 * projection->M;
+        const int pef = projection->ef_construction > 0
+                ? projection->ef_construction
+                : index->hnsw.efConstruction;
+        std::vector<idx_t> promoted = draw_promoted(n_train, pM);
+        std::vector<float> xp;
+        if (numeric_type_ == NumericType::Float32) {
+            xp = gather_rows_as_float(
+                    std::get<std::shared_ptr<CuvsCagra<float>>>(index_)
+                            ->get_training_dataset(),
+                    this->d,
+                    promoted);
+        } else if (numeric_type_ == NumericType::Float16) {
+            xp = gather_rows_as_float(
+                    std::get<std::shared_ptr<CuvsCagra<half>>>(index_)
+                            ->get_training_dataset(),
+                    this->d,
+                    promoted);
+        } else {
+            xp = gather_rows_as_float(
+                    std::get<std::shared_ptr<CuvsCagra<int8_t>>>(index_)
+                            ->get_training_dataset(),
+                    this->d,
+                    promoted);
+        }
+        project_upper_level(
+                index,
+                promoted,
+                xp,
+                this->d,
+                this->metric_type,
+                pM,
+                pef,
+                projection->max_share,
+                projection->protect_last_in_edge,
+                stats);
+    }
+
     // turn back on to allow new vectors to be added to level 0
     index->init_level0 = true;
 }
diff --git a/faiss/gpu/GpuIndexCagra.h b/faiss/gpu/GpuIndexCagra.h
index 7e5daa2..8f325b2 100644
--- a/faiss/gpu/GpuIndexCagra.h
+++ b/faiss/gpu/GpuIndexCagra.h
@@ -250,6 +250,47 @@ struct SearchParametersCagra : SearchParameters {
     uint64_t seed = 0x128394;
 };
 
+/// Optional step of GpuIndexCagra::copyTo for base-level-only conversions:
+/// build an HNSW layer 1 over a promoted subset of the vectors and project its
+/// links into the CAGRA base layer (level 0). On data made of well-separated
+/// clusters the CAGRA graph inherits the disconnected clusters of the k-NN
+/// graph it is pruned from; HNSW insertion creates near-neighbour links between
+/// clusters, which this step adds to level 0. The output stays base-level only
+/// and the file format is unchanged.
+struct CagraUpperLevelProjectionParams {
+    /// HNSW m of the index (required, > 0). Layer 1 is built like an HNSW
+    /// with 2 * M links per node, and a node is promoted to it with
+    /// probability 1 / (2 * M), drawn by faiss's HNSW level generator
+    /// (HNSW::random_level, seed 12345).
+    int M = 0;
+    /// efConstruction for the layer-1 build. 0 = index->hnsw.efConstruction.
+    int ef_construction = 0;
+    /// At most this share of a node's level-0 links may be overwritten by
+    /// projected links (tail slots first). Rows that are not full to begin
+    /// with are not capped (they may take links up to their full width).
+    float max_share = 0.5f;
+    /// Never overwrite a link that is the last level-0 in-edge of its target,
+    /// so the projection never makes a node unreachable.
+    bool protect_last_in_edge = true;
+};
+
+/// Counters reported by the projection step (optional output of copyTo).
+struct CagraUpperLevelProjectionStats {
+    idx_t promoted = 0;
+    size_t added_into_empty = 0;
+    size_t added_by_overwrite = 0;
+    size_t already_present = 0;
+    size_t skipped_cap = 0;
+    size_t protected_slots_skipped = 0;
+    size_t skipped_no_free_slot = 0;
+    /// level-0 rows that had empty slots before the projection (cap = 100%)
+    size_t rows_not_full = 0;
+    idx_t in_degree0_before = 0;
+    idx_t in_degree0_after = 0;
+    double layer1_build_ms = 0;
+    double projection_ms = 0;
+};
+
 struct GpuIndexCagra : public GpuIndex {
    public:
     GpuIndexCagra(
@@ -287,6 +328,15 @@ struct GpuIndexCagra : public GpuIndex {
             faiss::IndexHNSWCagra* index,
             bool skip_storage = false) const;
 
+    /// Same as above; if `projection` is not null (requires
+    /// index->base_level_only), also projects HNSW layer-1 links into level 0
+    /// (see CagraUpperLevelProjectionParams). `stats` is optional.
+    void copyTo(
+            faiss::IndexHNSWCagra* index,
+            bool skip_storage,
+            const CagraUpperLevelProjectionParams* projection,
+            CagraUpperLevelProjectionStats* stats = nullptr) const;
+
     void reset() override;
 
     std::vector<idx_t> get_knngraph() const;
-- 
